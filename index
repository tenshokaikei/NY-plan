<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>【完全図解】あなたに最適なアメリカ東海岸の旅</title>
    <style>
        /* =========================================
           基本設定・リセット
           ========================================= */
        :root {
            --bg-color: #f4f5f7;
            --text-main: #2c3e50;
            --text-muted: #596a7a;
            --accent-gold: #b8975a;
            --accent-blue: #34495e;
            --card-bg: #ffffff;
            --border-color: #e1e4e8;
            --ny-color: #2980b9;
            --dc-color: #c0392b;
            --bos-color: #27ae60;
            --font-base: 'Helvetica Neue', Arial, 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', Meiryo, sans-serif;
            --font-serif: 'Noto Serif JP', 'Yu Mincho', YuMincho, 'Hiragino Mincho ProN', serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font-base);
            background-color: var(--bg-color);
            color: var(--text-main);
            line-height: 1.6;
            font-size: 16px; /* ベースフォントサイズ */
            -webkit-font-smoothing: antialiased;
            padding: 2rem 1rem;
        }

        /* 最小フォントサイズ制限 (0.95rem = 15.2px) */
        .min-text, .badge, .tag, .note {
            font-size: 0.95rem !important;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background-color: var(--bg-color);
        }

        /* =========================================
           レイアウト・共通コンポーネント
           ========================================= */
        .top-banner {
            background-color: var(--accent-blue);
            color: #ffffff;
            padding: 3rem 2rem;
            border-radius: 12px;
            margin-bottom: 3rem;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .top-banner h1 {
            font-family: var(--font-serif);
            font-size: 2.5rem;
            margin-bottom: 1rem;
            letter-spacing: 0.05em;
        }

        .top-banner .date {
            color: #bdc3c7;
            margin-bottom: 2rem;
        }

        .conclusion-box {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 2rem;
            border-radius: 8px;
            max-width: 800px;
            margin: 0 auto;
            text-align: left;
        }

        .conclusion-box h2 {
            color: var(--accent-gold);
            font-size: 1.5rem;
            margin-bottom: 1rem;
            border-bottom: 2px solid var(--accent-gold);
            display: inline-block;
            padding-bottom: 0.3rem;
        }

        .flex-lists {
            display: flex;
            flex-wrap: wrap;
            gap: 2rem;
            margin-top: 1rem;
        }

        .flex-lists > div {
            flex: 1;
            min-width: 250px;
        }

        .flex-lists ul {
            list-style-type: none;
        }

        .flex-lists li {
            margin-bottom: 0.5rem;
            padding-left: 1.5rem;
            position: relative;
            font-size: 1.1rem;
        }

        .flex-lists li::before {
            content: "✓";
            color: var(--accent-gold);
            position: absolute;
            left: 0;
            font-weight: bold;
        }

        .section-title {
            font-family: var(--font-serif);
            font-size: 2.2rem;
            margin: 4rem 0 2rem;
            padding-bottom: 0.5rem;
            border-bottom: 3px solid var(--text-main);
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        /* ランキング */
        .ranking-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
            margin-bottom: 3rem;
        }

        .ranking-card {
            background: var(--card-bg);
            border-radius: 8px;
            padding: 1.5rem;
            display: flex;
            align-items: center;
            gap: 1.5rem;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            border-left: 5px solid var(--accent-gold);
            transition: transform 0.2s;
        }

        .ranking-card:hover {
            transform: translateY(-3px);
        }

        .rank-num {
            font-family: var(--font-serif);
            font-size: 2.5rem;
            color: var(--accent-gold);
            font-weight: bold;
            line-height: 1;
        }

        .rank-name {
            font-size: 1.2rem;
            font-weight: bold;
        }

        /* 都市別セクション */
        .city-wrapper {
            background: #ffffff;
            border-radius: 12px;
            padding: 3rem;
            margin-bottom: 3rem;
            box-shadow: 0 5px 20px rgba(0,0,0,0.03);
        }

        .city-wrapper.ny { border-top: 8px solid var(--ny-color); }
        .city-wrapper.dc { border-top: 8px solid var(--dc-color); }
        .city-wrapper.bos { border-top: 8px solid var(--bos-color); }

        .category-title {
            font-size: 1.5rem;
            color: var(--text-main);
            margin: 2.5rem 0 1.5rem;
            padding: 0.5rem 1rem;
            background: var(--bg-color);
            border-radius: 4px;
            display: inline-block;
        }

        .grid-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 2rem;
        }

        .spot-card {
            background: #fdfdfd;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 1.5rem;
            position: relative;
        }

        .spot-card.detailed {
            grid-column: 1 / -1; /* 詳細カードは全幅を使用 */
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 2rem;
            background: #fffbfa;
            border-color: #f0e6d2;
        }

        @media (max-width: 768px) {
            .spot-card.detailed {
                grid-template-columns: 1fr;
            }
        }

        .spot-header {
            margin-bottom: 1rem;
        }

        .spot-id {
            color: var(--text-muted);
            font-weight: bold;
            margin-right: 0.5rem;
        }

        .spot-name {
            font-size: 1.4rem;
            font-weight: bold;
            color: var(--text-main);
            display: inline-block;
            margin-bottom: 0.5rem;
        }

        .spot-name ruby {
            ruby-align: center;
        }

        .spot-name rt {
            font-size: 0.95rem;
            color: var(--text-muted);
            font-weight: normal;
        }

        .badges {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }

        .badge {
            padding: 0.2rem 0.6rem;
            border-radius: 20px;
            background: #eef2f5;
            color: #455a64;
            font-weight: bold;
        }

        .badge.super { background: #ffeaa7; color: #d35400; }
        .badge.match { background: #dff9fb; color: #22a6b3; }
        .badge.category { background: #34495e; color: #ffffff; }

        .spot-body p {
            margin-bottom: 0.8rem;
        }

        .detail-points {
            background: rgba(255,255,255,0.8);
            border: 1px dashed #dcdde1;
            padding: 1rem;
            border-radius: 6px;
        }

        .detail-points h4 {
            color: var(--accent-gold);
            margin-bottom: 0.5rem;
            font-size: 1.1rem;
        }

        .detail-points ul {
            padding-left: 1.2rem;
        }

        .detail-points li {
            margin-bottom: 0.4rem;
        }

        .highlight-box {
            background: var(--bg-color);
            padding: 1rem;
            border-left: 4px solid var(--accent-blue);
            margin: 1rem 0;
            border-radius: 0 4px 4px 0;
        }

        /* 刺さる場所リスト */
        .special-picks {
            background: #2c3e50;
            color: white;
            padding: 3rem;
            border-radius: 12px;
        }

        .special-picks h2 {
            text-align: center;
            color: var(--accent-gold);
            margin-bottom: 2rem;
            font-size: 2rem;
        }

        .picks-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
        }

        .pick-col h3 {
            border-bottom: 1px solid rgba(255,255,255,0.2);
            padding-bottom: 0.5rem;
            margin-bottom: 1rem;
            font-size: 1.5rem;
        }

        .pick-col ul {
            list-style: none;
        }

        .pick-col li {
            padding: 0.8rem 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            font-size: 1.1rem;
        }

        .pick-col li::before {
            content: "★";
            color: var(--accent-gold);
            margin-right: 0.5rem;
        }

        /* ユーティリティ */
        .text-bold { font-weight: bold; }
        .text-gold { color: var(--accent-gold); }
        .mt-2 { margin-top: 2rem; }
    </style>
</head>
